{
    "name": "imumd/free-sms-api",
    "description": "Fetch free US phone numbers and their latest SMS verification codes (OTP) as JSON.",
    "type": "project",
    "license": "MIT",
    "keywords": ["sms", "otp", "verification-code", "receive-sms", "temporary-phone-number", "scraper", "api"],
    "authors": [
        {
            "name": "iMumd",
            "email": "hi@mumd.dev",
            "homepage": "https://github.com/iMumd"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "FreeSms\\": "src/"
        }
    },
    "scripts": {
        "serve": "php -S 127.0.0.1:8080 -t public",
        "test": "php tests/run.php"
    }
}
